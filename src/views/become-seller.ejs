<link rel="stylesheet" href="/css/become-seller.css" />

<section class="seller-confirm-page">
  <div class="seller-confirm-card">
    <p class="seller-confirm-label">INOVA STORE</p>

    <h1>Become a Seller</h1>

    <p class="seller-confirm-description">
      You're about to switch your account from customer to seller.
    </p>

    <div class="seller-warning">
      <strong> Before you continue </strong>

      <p>
        Your account will gain access to seller features, including creating,
        editing, and managing your own products.
      </p>

      <p>
        For security, we'll send a verification code to your registered email
        address.
      </p>
    </div>

    <div class="seller-confirm-actions">
      <a href="/account" class="cancel-btn"> Cancel </a>

      <form method="POST" action="/become-seller">
        <button type="submit" class="continue-btn">Continue</button>
      </form>
    </div>
  </div>
</section>
