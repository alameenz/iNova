<link rel="stylesheet" href="/css/product.css">

<section class="products-page">

  <!-- =========================================
       HEADER
  ========================================== -->

  <div class="products-header">

    <div class="products-heading">

      <p class="products-label">
        INOVA STORE
      </p>

      <h1 class="page-title">
        Products
      </h1>

      <p class="products-subtitle">
        Explore our collection of premium Apple products.
      </p>

    </div>


    <!-- Seller Only -->

    <% if (user && user.role === "seller") { %>

      <a
        class="add-product-btn"
        href="/products/new"
      >
        <span>+</span>
        Add Product
      </a>

    <% } %>

  </div>


  <!-- =========================================
       PRODUCT GRID
  ========================================== -->

  <div class="product-container">

    <% products.forEach(product => { %>

      <article class="product-card">


        <!-- =====================================
             PRODUCT IMAGE
        ====================================== -->

        <a
          href="/products/details/<%= product._id %>"
          class="product-image"
        >

          <img
            src="<%= product.imageUrl %>"
            alt="<%= product.name %>"
          >

        </a>


        <!-- =====================================
             PRODUCT INFO
        ====================================== -->

        <div class="product-info">

          <p class="product-category">
            APPLE
          </p>

          <h3 class="name">
            <%= product.name %>
          </h3>

          <p class="description">
            <%= product.desc %>
          </p>

          <p class="price">
            $<%= product.price %>
          </p>


          <!-- =====================================
               ACTIONS
          ====================================== -->

          <div class="product-actions">


            <!-- EVERYONE CAN SEE THIS -->

            <a
              class="view-btn"
              href="/products/details/<%= product._id %>"
            >
              View Details
            </a>


            <!-- ===================================
                 SELLER OWNERSHIP ACTIONS
            ==================================== -->

            <% if (
              user &&
              user.role === "seller" &&
              product.seller.toString() === user._id.toString()
            ) { %>

              <div class="seller-actions">

                <a
                  class="edit-btn"
                  href="/products/edit/<%= product._id %>"
                >
                  Edit Product
                </a>


                <form
                  action="/products/delete/<%= product._id %>"
                  method="POST"
                >

                  <button
                    class="delete-btn"
                    type="submit"
                  >
                    Delete Product
                  </button>

                </form>

              </div>

            <% } %>

          </div>

        </div>

      </article>

    <% }) %>

  </div>

</section>