<link rel="stylesheet" href="/css/account.css">

<section class="account-page">

  <!-- Page Header -->

  <div class="account-header">

    <p class="account-label">
      INOVA ACCOUNT
    </p>

    <h1>
      Your Account
    </h1>

    <p class="account-subtitle">
      Manage your personal information and account details.
    </p>

  </div>


  <!-- Profile Card -->

  <div class="profile-card">

    <div class="profile-avatar">
      <span>
        <%= user.name.charAt(0).toUpperCase() %>
      </span>
    </div>

    <div class="profile-main">

      <h2>
        <%= user.name %>
      </h2>

      <p>
        <%= user.email %>
      </p>

      <span class="role-badge <%= user.role === 'seller' ? 'seller' : 'customer' %>">
        <%= user.role %>
      </span>

    </div>

  </div>


  <!-- Account Information -->

  <div class="account-section">

    <div class="section-header">

      <h2>
        Personal Information
      </h2>

      <p>
        Your account information.
      </p>

    </div>


    <div class="info-card">

      <div class="info-row">

        <div class="info-label">
          Full Name
        </div>

        <div class="info-value">
          <%= user.name %>
        </div>

      </div>


      <div class="info-row">

        <div class="info-label">
          Email Address
        </div>

        <div class="info-value">
          <%= user.email %>
        </div>

      </div>


      <div class="info-row">

        <div class="info-label">
          Account Type
        </div>

        <div class="info-value account-role">
          <%= user.role %>
        </div>

      </div>

    </div>

  </div>

  <!-- Seller Section -->

<div class="account-section">

  <% if (user.role === "customer") { %>

    <div class="section-header">

      <h2>
        Start Selling
      </h2>

      <p>
        Turn your account into a seller account and start listing products.
      </p>

    </div>

    <div class="seller-switch-card">

      <div class="seller-switch-info">

        <strong>
          Become a Seller
        </strong>

        <span>
          Sell your products on the iNova marketplace.
        </span>

      </div>

      <a
        href="/become-seller"
        class="seller-switch-btn"
      >
        Become a Seller
      </a>

    </div>

  <% } %>


  <!-- <% if (user.role === "seller") { %>

    <div class="section-header">

      <h2>
        Seller Account
      </h2>

      <p>
        Manage your products and seller account.
      </p>

    </div>

    <div class="seller-switch-card seller-active">

      <div class="seller-switch-info">

        <strong>
          You are a Seller
        </strong>

        <span>
          Manage your products from your seller dashboard.
        </span>

      </div>

      <a
        href="/seller/dashboard"
        class="seller-switch-btn"
      >
        Seller Dashboard
      </a>

    </div>

  <% } %> -->

</div>

  <!-- Account Actions -->

  <div class="account-section">

    <div class="section-header">

      <h2>
        Account
      </h2>

      <p>
        Manage your iNova account.
      </p>

    </div>


    <div class="actions-card">
      

      <a
        href="/products"
        class="account-action"
      >
        <div>
          
          <strong>
            Browse Products
          </strong>

          <span>
            Explore the iNova collection
          </span>
        </div>

        <span class="arrow">
          →
        </span>
      </a>


    <% if (user.role === "seller") { %>

      <a
        href="/seller/dashboard"
        class="account-action"
      >
        <div>

          <strong>
            Seller Dashboard
          </strong>

          <span>
            Manage your products and store
          </span>

        </div>

        <span class="arrow">
          →
        </span>
      </a>

        <a
          href="/products/new"
          class="account-action"
        >
          <div>
            <strong>
              Add Product
            </strong>

            <span>
              Add a new product to the store
            </span>
          </div>

          <span class="arrow">
            →
          </span>
        </a>

      <% } %>


      <form
        action="/logout"
        method="POST"
        class="logout-form"
      >

        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <button
          type="submit"
          class="logout-btn"
        >
          Sign Out
        </button>

      </form>

    </div>

  </div>

</section>