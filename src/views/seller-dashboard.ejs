<link rel="stylesheet" href="/css/seller-dashboard.css">

<section class="seller-dashboard">

  <!-- Dashboard Header -->

  <div class="dashboard-header">

    <div>
      <p class="dashboard-label">
        INOVA STORE
      </p>

      <h1 class="dashboard-title">
        Seller Dashboard
      </h1>

      <p class="dashboard-subtitle">
        Manage your products and track your store performance.
      </p>
    </div>

    <a
      href="/products/new"
      class="add-product-btn"
    >
      + Add Product
    </a>

  </div>


  <!-- Statistics -->

  <div class="stats-grid">

    <div class="stat-card">

      <div class="stat-content">

        <span class="stat-label">
          Total Products
        </span>

        <h2 class="stat-value">
          <%= totalProducts %>
        </h2>

      </div>

    </div>


    <div class="stat-card">

      <div class="stat-content">

        <span class="stat-label">
          Total Revenue
        </span>

        <h2 class="stat-value">
          $<%= totalRevenue.toFixed(2) %>
        </h2>

      </div>

    </div>

  </div>


  <!-- Products Section -->

  <section class="products-section">

    <div class="section-header">

      <div>
        <h2>
          My Products
        </h2>

        <p>
          Products you have added to the iNova store.
        </p>
      </div>

      <span class="product-count">
        <%= totalProducts %> Products
      </span>

    </div>


    <% if (products.length === 0) { %>

      <!-- Empty State -->

      <div class="empty-state">

        <div class="empty-icon">
          +
        </div>

        <h3>
          No products yet
        </h3>

        <p>
          You haven't added any products to your store.
        </p>

        <a
          href="/products/new"
          class="empty-add-btn"
        >
          Add Your First Product
        </a>

      </div>

    <% } else { %>

      <!-- Products Table -->

      <div class="products-table-wrapper">

        <table class="products-table">

          <thead>

            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>

          </thead>


          <tbody>

            <% products.forEach(product => { %>

              <tr>

                <td>

                  <div class="product-name">
                    <%= product.name %>
                  </div>

                </td>


                <td>

                  <span class="product-price">
                    $<%= product.price %>
                  </span>

                </td>


                <td>

                  <span class="product-date">
                    <%= product.createdAt.toLocaleDateString() %>
                  </span>

                </td>


                <td>

                  <div class="product-actions">

                    <a
                      href="/products/edit/<%= product._id %>"
                      class="edit-product-btn"
                    >
                      Edit
                    </a>


                    <form
                      method="POST"
                      action="/products/delete/<%= product._id %>"
                      class="delete-product-form"
                      onsubmit="return confirm('Are you sure you want to delete this product?')"
                    >

                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <button
                        type="submit"
                        class="delete-product-btn"
                      >
                        Delete
                      </button>

                    </form>

                  </div>

                </td>

              </tr>

            <% }); %>

          </tbody>

        </table>

      </div>

    <% } %>

  </section>

</section>