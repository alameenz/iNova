<link rel="stylesheet" href="/css/verify-seller.css" />

<section class="verify-page">
  <div class="verify-card">
    <p class="verify-label">INOVA STORE</p>

    <h1>Verify Your Email</h1>

    <p class="verify-description">
      We've sent a 6-digit verification code to your registered email address.
    </p>

    <form action="/verify-seller" method="POST" class="verify-form">
      <label for="otp"> Verification Code </label>

      <input
        type="text"
        id="otp"
        name="otp"
        placeholder="000000"
        maxlength="6"
        inputmode="numeric"
        autocomplete="one-time-code"
        required
      />

      <button type="submit" class="verify-btn">Verify & Become Seller</button>
    </form>

    <a href="/account" class="back-link"> ← Back to Account </a>
  </div>
</section>
