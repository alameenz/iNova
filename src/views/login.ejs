<link rel="stylesheet" href="/css/login.css">

<section class="auth-page">

  <div class="auth-container">

    <div class="auth-header">

      <a href="/" class="auth-logo">
        iNova
      </a>

      <h1>
        Welcome back.
      </h1>

      <p>
        Sign in to your iNova account.
      </p>

    </div>


    <form
      class="auth-form"
      action="/login"
      method="POST"
    >

      <div class="form-group">

        <label for="email">
          Email
        </label>

        <input
          type="email"
          id="email"
          name="email"
          placeholder="name@example.com"
          autocomplete="email"
          required
        >

      </div>


      <div class="form-group">

        <label for="password">
          Password
        </label>

        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >

      </div>


      <button
        type="submit"
        class="login-btn"
      >
        Sign In
      </button>

    </form>


    <div class="auth-divider">
      <span>or</span>
    </div>


    <p class="signup-text">
      Don't have an account?
      <a href="/signup">
        Create Account
      </a>
    </p>


    <a
      href="/"
      class="back-home"
    >
      ← Back to iNova
    </a>

  </div>

</section>