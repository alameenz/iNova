<link rel="stylesheet" href="/css/product-details.css">

<section class="details-page">

  <!-- Header -->

  <div class="details-header">

    <div>
      <p class="details-label">
        INOVA STORE
      </p>

      <h1 class="page-title">
        Product Details
      </h1>
    </div>

    <a class="back-btn" href="/products">
      ← Back to Products
    </a>

  </div>


  <!-- Product -->

  <article class="product-details">

    <!-- Product Image -->

    <div class="product-image">

      <img
        src="<%= product.imageUrl %>"
        alt="<%= product.name %>"
      >

    </div>


    <!-- Product Information -->

    <div class="product-info">

      <p class="product-category">
        APPLE PRODUCT
      </p>

      <h2 class="product-name">
        <%= product.name %>
      </h2>

      <div class="product-divider"></div>

      <p class="product-description">
        <%= product.desc %>
      </p>


      <!-- Price -->

      <div class="price-section">

        <span class="price-label">
          Price
        </span>

        <p class="product-price">
          $<%= product.price %>
        </p>

      </div>

      <!-- Sold by -->

<div class="seller-details-session">

  <div class="seller-header">
    <span class="seller-label">
      Sold by
    </span>
  </div>

  <div class="seller-info">

    <p class="seller-name">
      <%= product.seller.name %>
    </p>

    <a
      class="contact-seller-btn"
      href="mailto:<%= product.seller.email %>?subject=Regarding%20your%20product%20-%20<%= encodeURIComponent(product.name) %>"
    >
      Contact Seller
    </a>

  </div>

</div>


      <!-- Customer Actions -->

      <div class="cart-section">

        <form
          class="cart-form"
          action="/cart/add/<%= product._id %>"
          method="POST"
        >

          <div class="quantity-wrapper">

            <label for="quantity">
              Quantity
            </label>

            <div class="quantity-control"> 

              <button
                type="button"
                class="quantity-btn decrease-btn"
              >
                −
              </button>

              <input
                type="number"
                id="quantity"
                name="quantity"
                value="1"
                min="1"
                max="99"
                readonly
              >

              <button
                type="button"
                class="quantity-btn increase-btn"
              >
                +
              </button>

            </div>

          </div>


          <button
            type="submit"
            class="cart-btn"
          >
            Add to Cart
          </button>

        </form>

      </div>


      <!-- Seller Actions -->

      <% if (user && user.role === "seller") { %>
        <% if(product.seller.toString() === user._id.toString()) { %>

        <div class="seller-section">

          <p class="seller-label">
            SELLER ACTIONS
          </p>


          <a
            class="edit-btn"
            href="/products/edit/<%= product._id %>"
          >
            Edit Product
          </a>


          <form
            class="delete-form"
            action="/products/delete/<%= product._id %>"
            method="POST"
          >

            <button
              class="delete-btn"
              type="submit"
            >
              Delete Product
            </button>

          </form>

        </div>

        <% } %>
      <% } %>

    </div>

  </article>

</section>


<script src="/js/product-details.js"></script>